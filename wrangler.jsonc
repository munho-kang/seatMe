{
  "name": "seatme",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  // 서버를 서울 근처에서 돌린다. 이 줄이 없으면 미국에서 돌아 공공데이터가 1~7초 걸린다 (2026-11-14 측정)
  "placement": { "region": "aws:ap-northeast-2" },
  // 화면 파일은 dist/. /api/* 만 서버 코드가 받고, 나머지 모르는 주소는 화면(index.html)이 받는다
  "assets": { "directory": "dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // 서버 기록(로그)만 켠다. 추적(traces)은 공공데이터 요청 주소를 통째로 저장하는데, 그 주소에 인증키가 들어 있어 꺼 둔다
  // 취향 · 기록 · 이메일 계정 보관함 (표 kv 하나: 열쇠 → 값 JSON, migrations/). 내 컴퓨터(npm run server)에서는 .wrangler/ 안의 가짜 DB를 쓴다
  // 2026-11-17 KV(쓰기 하루 1,000번)에서 옮김. 예전 KV 0faf15d6…는 Cloudflare에 그대로 남아 있다
  "d1_databases": [{ "binding": "DB", "database_name": "seatme", "database_id": "7966337b-909b-4d7e-ba95-e9367181837a" }],
  // 이메일 로그인 · 회원가입 시도 제한: 같은 이메일(로그인) · 같은 IP(로그인 · 회원가입)로 1분에 10번 — 정확하지 않다 (server/auth/email.ts 머리 주석)
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true, "traces": { "enabled": false } }
}
